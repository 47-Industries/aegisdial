# ========================================================================
#  AegisDial — full environment reference
#  Every var the app reads. See src/config.ts for the source of truth.
# ========================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Data tier ----
DATABASE_URL=postgres://aegis:aegis@localhost:5432/aegisdial
REDIS_URL=memory://local

# ---- Auth (required) ----
API_SHARED_SECRET=change-me-dev-only
JWT_SECRET=dev-only-jwt-secret-change-me-immediately-in-production-12345

# ---- Apple ----
APPLE_CLIENT_ID=com.aegisdial.app
APPLE_BUNDLE_ID=com.aegisdial.app
APP_ATTEST_BUNDLE_ID=com.aegisdial.app
APP_ATTEST_ENV=development
APPLE_STOREKIT_ENV=sandbox
APPLE_APP_APPLE_ID=

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_FAMILY_PLUS_MONTHLY_PRICE_ID=

# ---- Enzoic (breach monitor) ----
ENZOIC_API_KEY=
ENZOIC_API_SECRET=
ENZOIC_MOCK=true

# ---- Google Safe Browsing (SMS URL reputation) ----
GOOGLE_SAFE_BROWSING_API_KEY=

# ---- Observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---- Transactional email ----
RESEND_API_KEY=
RESEND_FROM=AegisDial <alerts@aegisdial.com>

# ---- APNs push ----
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_PRODUCTION=false

# ---- Crawlers ----
YOUTUBE_API_KEY=
FCC_APP_TOKEN=
SERPER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AegisDial/0.1 (by /u/aegisdial) consumer-fraud-protection

# ---- Optional enrichment ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# ---- Feature flags ----
ENABLE_TWILIO_LOOKUP=false
ENABLE_LLM_REFINE=false
ENABLE_CRAWLERS=true
CRAWLER_RUN_ON_BOOT=false
SPOOF_VERIFY_ON_BOOT=false
