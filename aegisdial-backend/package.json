{
  "name": "aegisdial-backend",
  "version": "0.1.0",
  "description": "AegisDial verdict API — live spoof-call intelligence",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:full": "tsx src/scripts/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "crawl": "tsx src/scripts/run-crawler.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@apple/app-store-server-library": "^3.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@sentry/node": "^8.55.1",
    "apns2": "^11.8.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "imapflow": "^1.3.3",
    "ioredis": "^5.4.1",
    "jose": "^6.2.2",
    "libphonenumber-js": "^1.11.12",
    "mailparser": "^3.9.8",
    "node-cron": "^4.2.1",
    "pg": "^8.13.1",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.59.1",
    "posthog-node": "^4.18.0",
    "resend": "^4.8.0",
    "stripe": "^22.0.2",
    "twilio": "^5.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.3.0-beta.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
