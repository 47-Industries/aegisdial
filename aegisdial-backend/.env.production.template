# ========================================================================
#  AegisDial — production environment template
#
#  HOW TO USE:
#    1. Copy this file to .env.production (DO NOT commit)
#    2. Fill in every TODO
#    3. Run: bash scripts/setup-fly-secrets.sh
#
#  Anything marked (optional) is safe to leave blank for MVP — the code
#  no-ops gracefully. The pre-TestFlight runbook (DEPLOY_PLAYBOOK.md)
#  tells you which ones to get first and in what order.
# ========================================================================

# ---- Core ----
# NOTE: PORT is intentionally omitted here. fly.toml's [env] block already
# sets PORT=3000, and internal_port in [http_service] is 3000. If we push
# a PORT=8080 via `fly secrets set` the runtime secret would override the
# [env] default, the app would bind 8080, Fly would keep routing health
# checks to 3000, and the deploy would 502 forever. Leave it unset.
NODE_ENV=production
LOG_LEVEL=info

# ---- Data tier (live, from Neon + Upstash) ----
# Neon dashboard → your project → Connection Details → copy URI (require SSL).
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# Upstash console → your db → REST → copy REDIS_URL (uses rediss://).
# REDIS_URL=rediss://default:PASS@HOST:PORT

# ---- Auth secrets (GENERATE NEW RANDOMLY — do NOT commit values) ----
# API_SHARED_SECRET — any 48-char random. `openssl rand -base64 36`
# JWT_SECRET — any 48-char random (rotating invalidates all active sessions)
# API_SHARED_SECRET=TODO_48CHAR_RANDOM
# JWT_SECRET=TODO_48CHAR_RANDOM

# ---- Apple (for Sign in with Apple + StoreKit verification) ----
APPLE_CLIENT_ID=com.aegisdial.app
APPLE_BUNDLE_ID=com.aegisdial.app
APP_ATTEST_BUNDLE_ID=com.aegisdial.app
APP_ATTEST_ENV=production
APPLE_STOREKIT_ENV=production
# From App Store Connect → Apps → AegisDial → App Information → Apple ID
# APPLE_APP_APPLE_ID=TODO_NUMERIC_APP_ID

# ---- Stripe (web subscription backup path) ----
# Get from dashboard.stripe.com after creating products.
# STRIPE_SECRET_KEY=sk_live_TODO
# STRIPE_WEBHOOK_SECRET=whsec_TODO
# STRIPE_MONTHLY_PRICE_ID=price_TODO
# STRIPE_YEARLY_PRICE_ID=price_TODO
# STRIPE_FAMILY_PLUS_MONTHLY_PRICE_ID=price_TODO

# ---- Enzoic (pre-attack breach monitoring) ----
# Sign up at https://www.enzoic.com/developers/
# Leave unset + ENZOIC_MOCK=true to keep mock mode in staging.
# ENZOIC_API_KEY=TODO
# ENZOIC_API_SECRET=TODO
ENZOIC_MOCK=false

# ---- Google Safe Browsing (SMS URL reputation) ----
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# Enable API in project my-project-37237aegisdial, create key.
# GOOGLE_SAFE_BROWSING_API_KEY=TODO

# ---- Sentry (error tracking) ----
# sentry.io → Settings → Projects → aegisdial-api → Client Keys (DSN)
# SENTRY_DSN=https://TODO@oXXX.ingest.us.sentry.io/TODO
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- PostHog (product analytics) ----
# app.posthog.com → Project Settings → Project API Key
# POSTHOG_API_KEY=phc_TODO
POSTHOG_HOST=https://us.i.posthog.com

# ---- Resend (transactional email) ----
# resend.com → API Keys, plus add + verify aegisdial.com domain.
# RESEND_API_KEY=re_TODO
RESEND_FROM=AegisDial <alerts@aegisdial.com>

# ---- APNs (push notifications) ----
# developer.apple.com → Certificates, IDs & Profiles → Keys → + → APNs
# Download the .p8 file ONCE and paste its contents below (PEM format).
# APNS_KEY_ID=TODO_10_CHAR
# APNS_TEAM_ID=TODO_10_CHAR
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----
# MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...
# -----END PRIVATE KEY-----"
APNS_PRODUCTION=true

# ---- YouTube (crawler) ----
# console.cloud.google.com → APIs & Services → Credentials → create API key.
# YOUTUBE_API_KEY=TODO

# ---- Optional enrichment services ----
# FCC_APP_TOKEN=
# SERPER_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---- Feature flags ----
ENABLE_TWILIO_LOOKUP=false
ENABLE_LLM_REFINE=false
ENABLE_CRAWLERS=true
